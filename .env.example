SCREENSHOT_API="http://localhost:5006" # Screenshot's API URL, see compose.yml
GITHUB_PROJECTS_SOURCES="" # GitHub sources separated by commas (,)
GITHUB_TOKEN="ghp_your_token_here" # GitHub token without any permissions (just for auth and rate limits)
GITHUB_PROJECTS_MIN_STARS=2 # Minimun number of stars for github repositories to be shown
TERMINAL_HISTORY_LIMIT=50 # Maximum entries in the terminal's history
BASE_URL="https://racca.me" # Base URL of the production website
