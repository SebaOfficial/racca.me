		"rehype-slug": "^6.0.0",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-seo": "^2.0.0",
		"tailwindcss": "^4.3.3",
		"to-ico": "^1.1.5",
		"tslog": "^5.4.0",
